# ============================================================
# AG-Extension Dashboard — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ────────────────────────────────────────────────
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me-in-prod
DATABASE_NAME=ag_extension
DATABASE_HOST=127.0.0.1
DATABASE_PORT=7501

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=7502
REDIS_PASSWORD=change-me-in-prod

# ── Application Ports (host bindings) ───────────────────────
BACKEND_PORT=7500
FRONTEND_PORT=7503

# ── Docker Build Targets ────────────────────────────────────
DOCKER_BACKEND_TARGET=development
DOCKER_FRONTEND_TARGET=development

# ── Traefik / Domain ────────────────────────────────────────
DOMAIN=www.gpexts.com
TRAEFIK_HTTP_PORT=80

# ── Security ────────────────────────────────────────────────
# Generate with: openssl rand -base64 48 | tr -d '/+' | head -c 64
JWT_SECRET=your-super-secret-jwt-key-change-me

# ── AI / LLM Providers ──────────────────────────────────────
AI_PRIMARY_PROVIDER=groq
AI_PRIMARY_MODEL=llama-3.3-70b-versatile
AI_EMBEDDINGS_PROVIDER=openai
AI_EMBEDDINGS_MODEL=text-embedding-3-large
OLLAMA_HOST=http://ettametta-ollama:11434
OLLAMA_MODEL=llama3.2:3b
AI_FALLBACK_PROVIDER=ollama

# Primary provider key (Groq is the default primary)
GROQ_API_KEY=

# Optional alternative providers
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
ANTHROPIC_API_KEY=
GOOGLE_VERTEX_PROJECT_ID=

# OmniRoute multi-LLM failover providers (score-sorted free catalog)
AIHUBMIX_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
NVIDIA_API_KEY=

WEATHER_API_KEY=
TAVILY_API_KEY=

# ── Demo Mode ───────────────────────────────────────────────
DEMO_ENABLED=false
DEMO_PASSWORD=change-this-password

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info

# ── Production (SSL/TLS via Let's Encrypt) ─────────────────
ACME_EMAIL=admin@gpexts.com

# ── Resource Limits (Production) ───────────────────────────
MEMORY_LIMIT=1G
CPU_LIMIT=1.0

# ── Frontend ────────────────────────────────────────────────
VITE_API_URL=/api
VITE_WS_URL=

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:7503
