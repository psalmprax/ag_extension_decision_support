# postgis/postgis:15-3.4 (Debian-based) — includes PostGIS + Postgres 15
# pgvector pre-compiled via apt (minutes instead of compiling from source)
FROM postgis/postgis:15-3.4

# Install pre-built pgvector package — avoids 7+ minute from-source compile
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        postgresql-15-pgvector \
    && rm -rf /var/lib/apt/lists/*
