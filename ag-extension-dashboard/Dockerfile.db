# postgis/postgis:15-3.4 (Debian-based) — includes PostGIS + Postgres 15
# pgvector pre-compiled via apt (minutes instead of compiling from source)
FROM postgis/postgis:15-3.4

# Install pre-built pgvector package — avoids 7+ minute from-source compile.
# Retry transient Debian/PGDG mirror resets without hiding permanent failures.
# Check-Valid-Until=false: postgis:15-3.4 is bullseye-based (EOL) and its
# security Release metadata has expired; PGDG moved bullseye-pgdg to
# apt-archive.postgresql.org.
RUN set -eux; \
    sed -i 's|http://apt\.postgresql\.org|https://apt-archive\.postgresql\.org|g' /etc/apt/sources.list.d/pgdg.list; \
    printf 'Acquire::Retries "5";\nAcquire::http::Pipeline-Depth "0";\nAcquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/80-retries; \
    for attempt in 1 2 3; do \
      apt-get update && \
      apt-get install -y --no-install-recommends postgresql-15-pgvector && \
      break; \
      if [ "$attempt" -eq 3 ]; then exit 1; fi; \
      rm -rf /var/lib/apt/lists/*; \
      sleep $((attempt * 5)); \
    done; \
    rm -rf /var/lib/apt/lists/*
