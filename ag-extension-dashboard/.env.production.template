# ─── Optional — Feature Flags ───────────────────────────────────────────
# DEMO_ENABLED=true            # Set false to disable demo mode in production
# DEMO_PASSWORD=               # Override demo user password if enabled
# RATE_LIMIT_DISABLED=false
# KNOWLEDGE_TTS_ENABLED=false

# ─── Optional — Remote Sensing ─────────────────────────────────────────
# NASA_EARTHDATA_KEY=
# SENTINEL_HUB_CLIENT_ID=
# SENTINEL_HUB_CLIENT_SECRET=

# ─── Optional — Push Notifications ──────────────────────────────────────
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=

# ─── Optional — Search ──────────────────────────────────────────────────
# TAVILY_API_KEY=

# ─── Docker Compose Variable Passthrough ────────────────────────────────
# These are read by docker-compose.yml, not the app directly:
DATABASE_USER=postgres
DATABASE_NAME=ag_extension
DATABASE_PORT=127.0.0.1:7501
REDIS_PORT=127.0.0.1:7502
# ── Resilience ───────────────────────────────────────────────────────────────
# Uploads (photos, voice notes, documents) in object storage instead of this server's
# disk. Any S3-compatible store: AWS S3, Cloudflare R2, Backblaze B2, MinIO.
# Then copy existing files once: scripts/uploads-to-object-storage.ts (see its header).
STORAGE_BACKEND=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Off-site, encrypted database backups (the db-backup sidecar). Use a different
# bucket or account from uploads. Keep the passphrase somewhere other than this server:
# without it the backups cannot be read. Check restores with scripts/restore-drill.sh.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_S3_RETENTION_DAYS=35

# Uploads are refused, not let through unscanned, while the virus scanner is down.
CLAMD_FAIL_OPEN=false

# ── Countries ────────────────────────────────────────────────────────────────
# The country assumed for a phone number written without its country code when the
# person's own country is not known (country profiles: ag-extension-shared/src/api/countries.ts).
DEFAULT_COUNTRY=Kenya

# ── Voice question line (Africa's Talking voice) ─────────────────────────────
# Farmers call the number and record a question; it reaches their officer like a message
# and the reply goes back by SMS. Set the number's callback URL to
#   https://<site>/api/v1/voice-line/callback?key=<AFRICASTALKING_WEBHOOK_SECRET>
# Calls to the number are charged by the provider; check the rates before switching it on.
VOICE_LINE_ENABLED=false
# Optional: a person reading the greeting, per language (an https URL to an mp3).
# Without one, the greeting is spoken in English by the provider's voice.
VOICE_LINE_GREETING_SW=
VOICE_LINE_GREETING_FR=
VOICE_LINE_GREETING_PT=
