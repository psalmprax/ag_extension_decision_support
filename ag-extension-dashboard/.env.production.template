# =============================================================================
# Ag-Extension Decision Support Platform — Production Environment Template
# =============================================================================
# Copy to .env on your production host and fill in every REQUIRED value.
# Never commit this file — it contains secrets. Add .env to .gitignore.
# =============================================================================

# ─── REQUIRED — Core Secrets ───────────────────────────────────────────
# Generate with: openssl rand -hex 32 (or 64 for JWT)

JWT_SECRET=                   # REQUIRED — 64+ char random string
CREDENTIAL_ENCRYPTION_KEY=    # REQUIRED — 32-byte hex key (openssl rand -hex 32)
DATABASE_PASSWORD=            # REQUIRED — 32+ char random, overrides docker-compose default
REDIS_PASSWORD=               # REQUIRED — 32+ char random, overrides docker-compose default
META_WEBHOOK_VERIFY_TOKEN=    # REQUIRED — 32+ char random for WhatsApp webhook verification

# ─── REQUIRED — Deployment ─────────────────────────────────────────────
NODE_ENV=production
DOMAIN=www.gpexts.com
SERVER_IP=145.223.97.248
API_BASE_URL=https://api.gpexts.com
FRONTEND_URL=https://www.gpexts.com
CORS_ORIGIN=https://www.gpexts.com
ACME_EMAIL=                   # REQUIRED — email for Let's Encrypt certificate expiry notices
DATABASE_URL=postgresql://postgres:${DATABASE_PASSWORD}@app-db:5432/ag_extension?schema=public
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ─── REQUIRED — AI Provider (at least one) ─────────────────────────────
AI_PRIMARY_PROVIDER=openai    # openai | anthropic | groq | ollama
AI_PRIMARY_MODEL=gpt-4o
OPENAI_API_KEY=               # REQUIRED — or set another provider's key

# ─── REQUIRED — SMS / Communication (at least one) ─────────────────────
AFRICASTALKING_API_KEY=       # REQUIRED — or set TWILIO_ACCOUNT_SID below
AFRICASTALKING_USERNAME=sandbox
# TWILIO_ACCOUNT_SID=         # Alternative SMS provider
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ─── Optional — Additional AI Providers ─────────────────────────────────
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# AIHUBMIX_API_KEY=
# OPENROUTER_API_KEY=
# HUGGINGFACE_API_KEY=
# NVIDIA_API_KEY=

# ─── Optional — WhatsApp / Telegram ────────────────────────────────────
# META_PHONE_NUMBER_ID=
# META_ACCESS_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=AgExtensionBot

# ─── Optional — Payments ───────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# ─── Optional — Email ───────────────────────────────────────────────────
# EMAIL_SERVICE=smtp
# EMAIL_FROM=noreply@gpexts.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ─── Optional — Monitoring ─────────────────────────────────────────────
# SENTRY_DSN=
# LOG_LEVEL=warn

# ─── Optional — Feature Flags ───────────────────────────────────────────
# DEMO_ENABLED=true            # Set false to disable demo mode in production
# DEMO_PASSWORD=               # Override demo user password if enabled
# RATE_LIMIT_DISABLED=false
# KNOWLEDGE_TTS_ENABLED=false

# ─── Optional — Remote Sensing ─────────────────────────────────────────
# NASA_EARTHDATA_KEY=
# SENTINEL_HUB_CLIENT_ID=
# SENTINEL_HUB_CLIENT_SECRET=

# ─── Optional — Push Notifications ──────────────────────────────────────
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=

# ─── Optional — Search ──────────────────────────────────────────────────
# TAVILY_API_KEY=

# ─── Docker Compose Variable Passthrough ────────────────────────────────
# These are read by docker-compose.yml, not the app directly:
DATABASE_USER=postgres
DATABASE_NAME=ag_extension
DATABASE_PORT=127.0.0.1:7501
REDIS_PORT=127.0.0.1:7502