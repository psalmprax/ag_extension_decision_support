{
  "name": "ag-extension-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run audit-locales && tsc && vite build",
    "build:docker": "npm run audit-locales && tsc && vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 20",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --config playwright.e2e.config.ts",
    "test:offline-browser": "node --test tests/offline-security.browser.mjs",
    "audit-locales": "node ../../scripts/check-locale-source.js && node ../../scripts/audit-locales.js && node ../../scripts/validate-locale-content.js",
    "validate-locales": "node ../../scripts/validate-locale-content.js",
    "sync-locales": "node ../../scripts/sync-locales.js",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "prepare": "husky"
  },
  "dependencies": {
    "@ag-extension/shared": "file:../../../ag-extension-shared",
    "@capacitor/android": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@headlessui/react": "^1.7.17",
    "@hookform/resolvers": "^5.2.2",
    "@sentry/react": "^10.78.0",
    "@tanstack/react-query": "^5.14.2",
    "@types/dompurify": "^3.0.5",
    "@types/leaflet": "^1.9.21",
    "axios": "^1.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "d3-geo": "^3.1.2",
    "date-fns": "^3.0.6",
    "dompurify": "^3.4.17",
    "framer-motion": "^10.17.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.303.0",
    "onnxruntime-web": "^1.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.71.2",
    "react-hot-toast": "^2.4.1",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.10.3",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.7.2",
    "tailwind-merge": "^3.6.0",
    "three": "^0.181.2",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^7.6.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^25.4.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/three": "^0.181.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.16",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "msw": "^2.12.10",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.12",
    "workbox-cacheable-response": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0"
  },
  "overrides": {
    "follow-redirects": "^1.16.1",
    "tar": "^7.5.22",
    "socket.io-parser": "^4.2.7",
    "lodash": "^4.18.0",
    "form-data": "^4.0.6",
    "picomatch": "^4.0.4",
    "fast-uri": "^3.1.6",
    "js-yaml": "^4.3.2",
    "@xmldom/xmldom": "^0.9.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
