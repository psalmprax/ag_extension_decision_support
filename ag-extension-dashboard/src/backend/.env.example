# ==============================================================================
# Object Storage Configuration (Backblaze B2, Cloudflare R2, Wasabi, Hetzner, AWS S3, Local)
# ==============================================================================
#
# Supported Backends: 'b2' | 'r2' | 'wasabi' | 'hetzner' | 's3' | 'minio' | 'local'
#
# Cost Profiles:
# 1. Backblaze B2: CHEAPEST RAW STORAGE ($0.006/GB = $6/TB/mo; $0 egress via Cloudflare CDN)
# 2. Cloudflare R2: CHEAPEST HIGH-STREAMING ($0.015/GB; $0.00 egress bandwidth always)
# 3. Hetzner: CHEAPEST EUROPEAN HOSTING (~€0.005/GB; 20 TB egress free)
# 4. Local Disk: Zero-cloud offline fallback (uploads saved to ./uploads)

# --- Option A: Backblaze B2 (Cheapest Raw Storage: $0.006/GB) ---
# STORAGE_BACKEND=b2
# S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# S3_REGION=us-west-004
# S3_BUCKET=ag-extension-media
# S3_ACCESS_KEY_ID=your-b2-key-id
# S3_SECRET_ACCESS_KEY=your-b2-application-key
# S3_PUBLIC_URL=https://media.ag-extension.org
# S3_FORCE_PATH_STYLE=false

# --- Option B: Cloudflare R2 (Zero Egress Bandwidth) ---
STORAGE_BACKEND=r2
S3_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=ag-extension-media
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
S3_PUBLIC_URL=https://media.ag-extension.org
S3_FORCE_PATH_STYLE=false

# --- Option C: Wasabi ($0.0069/GB) ---
# STORAGE_BACKEND=wasabi
# S3_ENDPOINT=https://s3.us-east-1.wasabisys.com
# S3_REGION=us-east-1
# S3_BUCKET=ag-extension-media
# S3_ACCESS_KEY_ID=your-wasabi-access-key
# S3_SECRET_ACCESS_KEY=your-wasabi-secret-key

# --- Option D: Hetzner Object Storage (~€0.005/GB) ---
# STORAGE_BACKEND=hetzner
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_REGION=fsn1
# S3_BUCKET=ag-extension-media
# S3_ACCESS_KEY_ID=your-hetzner-access-key
# S3_SECRET_ACCESS_KEY=your-hetzner-secret-key

# Local Storage Directory (used when STORAGE_BACKEND=local or for dual local cache)
UPLOAD_DIR=./uploads
LOCAL_CACHE_ENABLED=true

# Upload Limits
MAX_UPLOAD_MB=100
UPLOAD_QUOTA_MB=2048
