# ==============================================================================
# Object Storage Configuration (Cloudflare R2, Backblaze B2, AWS S3, Local Disk)
# ==============================================================================
# Recommended Platform: Cloudflare R2 (Cheapest & Most Reliable for Video, Audio, Reports)
# - Zero egress bandwidth costs ($0.00/GB)
# - 10 GB storage free every month ($0.015/GB/mo thereafter)
# - 1,000,000 Class A (writes) and 10,000,000 Class B (reads) free every month
# - S3 REST API compatible

# Storage Backend: 'r2' | 'b2' | 's3' | 'minio' | 'local'
STORAGE_BACKEND=r2

# S3 / Cloudflare R2 / Backblaze B2 Connection Credentials
# For Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# For Backblaze B2:  https://s3.<REGION>.backblazeb2.com
# For AWS S3:        (leave S3_ENDPOINT blank or specify regional endpoint)
# For MinIO / Local: http://localhost:9000
S3_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=ag-extension-media
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Optional Public CDN URL for Zero-Egress Direct Media Streaming
# Point a custom domain or Cloudflare DNS record to your bucket
S3_PUBLIC_URL=https://media.ag-extension.org

# Set to 'true' if using MinIO or path-style endpoints
S3_FORCE_PATH_STYLE=false

# Local Storage Directory (used when STORAGE_BACKEND=local or for dual local cache)
UPLOAD_DIR=./uploads
LOCAL_CACHE_ENABLED=true

# Upload Limits
MAX_UPLOAD_MB=100
UPLOAD_QUOTA_MB=2048
