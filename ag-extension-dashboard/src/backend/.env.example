# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ag_extension
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# AI Provider Configuration
# Primary AI Provider (azure_openai, google_vertex, openai, anthropic)
AI_PRIMARY_PROVIDER=azure_openai
AI_PRIMARY_MODEL=gpt-4
AI_PRIMARY_REGION=eastus

# Fallback AI Provider
AI_FALLBACK_PROVIDER=google_vertex
AI_FALLBACK_MODEL=gemini-pro
AI_FALLBACK_REGION=us-central1

# Embeddings Provider
AI_EMBEDDINGS_PROVIDER=openai
AI_EMBEDDINGS_MODEL=text-embedding-3-large

# Speech Provider
AI_SPEECH_PROVIDER=azure_speech
AI_SPEECH_VOICE=standard

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4

# Google Vertex AI Configuration
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
GOOGLE_VERTEX_PROJECT_ID=your-project-id
GOOGLE_VERTEX_LOCATION=us-central1

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key

# Anthropic Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key

# Groq Configuration
GROQ_API_KEY=your-groq-api-key

# Freebuff Configuration (community-proxied free LLM access)
# WARNING: This is a BEST-EFFORT FALLBACK ONLY. The Freebuff2API project
# is a community-maintained proxy for free LLM access (DeepSeek, Kimi, MiniMax).
# Not an official API - no SLA, may rate-limit, or go offline without notice.
# Never set this as a primary provider.
FREEBUFF_AUTH_TOKEN=your-freebuff-auth-token
FREEBUFF_API_BASE_URL=https://api.freebuff2api.dev/v1
FREEBUFF_DEFAULT_MODEL=deepseek-chat

# External API Configuration
# Weather: get a free key at https://www.weatherapi.com/ (1M calls/month free tier).
# The /api/v1/health endpoint counts this as configured only when WEATHER_API_KEY is set.
WEATHER_API_KEY=your-weather-api-key
WEATHER_API_URL=https://api.weatherapi.com/v1
FAO_API_URL=https://fenixservices.fao.org/fao/v1

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Stripe Configuration (for monetization)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# SMS/USSD Configuration (Africa's Talking or Twilio)
# Africa's Talking (recommended for Africa)
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_USERNAME=sandbox

# Twilio (alternative)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Sentry Error Tracking (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# CDN Configuration (optional)
CDN_URL=https://cdn.yourdomain.com

# Demo Configuration
DEMO_PASSWORD=demo-password-123
