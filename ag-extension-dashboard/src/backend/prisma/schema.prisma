model UserSession {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  ipAddress    String?   @map("ip_address") @db.VarChar(64)
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  device       String?   @db.VarChar(100)
  location     String?   @db.VarChar(150)
  lastActiveAt DateTime  @default(now()) @map("last_active_at") @db.Timestamp(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamp(6)
  isRevoked    Boolean   @default(false) @map("is_revoked")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@index([tokenHash])
  @@map("user_sessions")
}

model SupportTicket {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  createdBy   String    @map("created_by") @db.Uuid
  subject     String    @db.VarChar(255)
  description String
  category    String    @default("general") @db.VarChar(50)
  priority    String    @default("medium") @db.VarChar(20)
  status      String    @default("open") @db.VarChar(20)
  assignedTo  String?   @map("assigned_to") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  creator     User      @relation("SupportTicketCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  assignee    User?     @relation("SupportTicketAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([createdBy])
  @@index([tenantId])
  @@index([status])
  @@map("support_tickets")
}

model WhatsappMessage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String?   @map("tenant_id") @db.Uuid
  fromPhone      String?   @map("from_phone") @db.VarChar(20)
  toPhone        String    @map("to_phone") @db.VarChar(20)
  body           String
  direction      String    @default("outbound") @db.VarChar(20)
  status         String    @default("queued") @db.VarChar(20)
  providerId     String?   @map("provider_id") @db.VarChar(255)
  farmerId       String?   @map("farmer_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  farmer         Farmer?   @relation(fields: [farmerId], references: [id], onDelete: SetNull)
  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([toPhone])
  @@index([farmerId])
  @@index([tenantId])
  @@index([status])
  @@map("whatsapp_messages")
}

model SmsFeedback {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  smsHistoryId String?  @map("sms_history_id") @db.Uuid
  farmerId    String?   @map("farmer_id") @db.Uuid
  rating      Int?
  comment     String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  farmer      Farmer?   @relation(fields: [farmerId], references: [id], onDelete: SetNull)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([farmerId])
  @@index([tenantId])
  @@map("sms_feedback")
}


