generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String             @unique @db.VarChar(255)
  passwordHash  String             @map("password_hash") @db.VarChar(255)
  firstName     String             @map("first_name") @db.VarChar(100)
  lastName      String             @map("last_name") @db.VarChar(100)
  role          String             @default("extension_officer") @db.VarChar(50)
  region        String?            @db.VarChar(100)
  phone         String?            @db.VarChar(20)
  avatarUrl     String?            @map("avatar_url")
  isActive      Boolean?           @default(true) @map("is_active")
  resetToken    String?            @map("reset_token") @db.VarChar(255)
  resetTokenExpires DateTime?      @map("reset_token_expires") @db.Timestamp(6)
  createdAt     DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime?          @default(now()) @map("updated_at") @db.Timestamp(6)
  farmers       Farmer[]
  assignedFarmers Farmer[]          @relation("FarmerOfficer")
  visits        Visit[]
  conversations ChatConversation[]
  reports       Report[]
  analytics     AnalyticsEvent[]
  subscription  Subscription?
  pushSubscriptions PushSubscription[]
  notifications     Notification[]
  transactionSubmissions TransactionSubmission[]
  redeemedVouchers Voucher[] @relation("RedeemedVouchers")
  scheduledSMS  ScheduledSMS[]
  knowledgeSearches KnowledgeSearch[] @relation("UserKnowledgeSearches")
  apiClients    ApiClient[]

  @@map("users")
}

model ScheduledSMS {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  phoneNumber     String   @map("phone_number") @db.VarChar(20)
  message         String
  scheduledAt     DateTime @map("scheduled_at") @db.Timestamp(6)
  status          String   @default("pending") @db.VarChar(20) // 'pending', 'sent', 'failed'
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamp(6)
  user            User     @relation(fields: [userId], references: [id])

  @@map("scheduled_sms")
}

model Farmer {
   id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
   userId                   String?            @map("user_id") @db.Uuid
   assignedOfficerId        String?            @map("assigned_officer_id") @db.Uuid
   firstName                String             @map("first_name") @db.VarChar(100)
   lastName                 String             @map("last_name") @db.VarChar(100)
   phone                    String?            @db.VarChar(20)
   location                 String?            @db.VarChar(255)
   village                  String?            @db.VarChar(100)
   district                 String?            @db.VarChar(100)
   region                   String?            @db.VarChar(100)
   country                  String?            @default("Kenya") @db.VarChar(100)
   farmSizeHectares         Decimal?           @map("farm_size_hectares") @db.Decimal(10, 2)
   crops                    String[]
   vitalScore               Decimal?           @map("vital_score") @db.Decimal(5, 2)
   soilMoisture             Decimal?           @map("soil_moisture") @db.Decimal(5, 2)
   temperature              Decimal?           @db.Decimal(5, 2)
   phLevel                  Decimal?           @map("ph_level") @db.Decimal(4, 2)
   aiConfidence             Decimal?           @map("ai_confidence") @db.Decimal(5, 2)
   yieldHistory             Json?              @map("yield_history")
   locationLat              Decimal?           @map("location_lat") @db.Decimal(10, 8)
   locationLng              Decimal?           @map("location_lng") @db.Decimal(11, 8)
   languagePreference       String?            @default("en") @map("language_preference") @db.VarChar(20)
   isActive                 Boolean?           @default(true) @map("is_active")
   assignmentNotificationSent Boolean           @default(false) @map("assignment_notification_sent")
   order                    Int?               @default(0) @db.Integer
   createdAt                DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
   updatedAt                DateTime?          @default(now()) @map("updated_at") @db.Timestamp(6)
   user                     User?              @relation(fields: [userId], references: [id])
   assignedOfficer          User?              @relation("FarmerOfficer", fields: [assignedOfficerId], references: [id])
   visits                   Visit[]
   conversations            ChatConversation[]
   analytics                AnalyticsEvent[]
   fields                   Field[]

  @@index([assignedOfficerId])
  @@index([region])
  @@index([userId])
  @@map("farmers")
}

model Visit {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officerId            String?   @map("officer_id") @db.Uuid
  farmerId             String?   @map("farmer_id") @db.Uuid
  visitType            String?   @default("routine") @map("visit_type") @db.VarChar(50)
  status               String?   @default("scheduled") @db.VarChar(50)
  scheduledAt          DateTime? @map("scheduled_at") @db.Timestamp(6)
  startedAt            DateTime? @map("started_at") @db.Timestamp(6)
  completedAt          DateTime? @map("completed_at") @db.Timestamp(6)
  durationMinutes      Int?      @map("duration_minutes")
  locationLat          Decimal?  @map("location_lat") @db.Decimal(10, 8)
  locationLng          Decimal?  @map("location_lng") @db.Decimal(11, 8)
  notes                String?
  outcomes             String?
  followUpRequired     Boolean?  @default(false) @map("follow_up_required")
  followUpDate         DateTime? @map("follow_up_date") @db.Date
  reminderSent         Boolean?  @default(false) @map("reminder_sent")
  overdueAlertSent    Boolean?  @default(false) @map("overdue_alert_sent")
  followUpReminderSent Boolean?  @default(false) @map("follow_up_reminder_sent")
  createdAt            DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  officer              User?     @relation(fields: [officerId], references: [id])
  farmer               Farmer?   @relation(fields: [farmerId], references: [id])

  @@index([farmerId])
  @@index([officerId])
  @@index([status])
  @@map("visits")
}

model KnowledgeArticle {
   id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
   title       String    @db.VarChar(255)
   content     String
   contentType String?   @default("text") @map("content_type") @db.VarChar(50)
   summary     String?
   category    String?   @db.VarChar(100)
   tags        String[]
   crops       String[]
   regions     String[]
   source      String?   @db.VarChar(255)
   sourceUrl   String?   @map("source_url")
   embedding   Float[]
   order       Int?      @default(0) @db.Integer
   createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
   updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

   @@index([category])
   @@index([tags], type: Gin)
   @@index([crops], type: Gin)
   @@map("knowledge_articles")
}

model ChatConversation {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmerId              String?       @map("farmer_id") @db.Uuid
  officerId             String?       @map("officer_id") @db.Uuid
  language              String?       @default("en") @db.VarChar(20)
  status                String?       @default("active") @db.VarChar(50)
  startedAt             DateTime?     @default(now()) @map("started_at") @db.Timestamp(6)
  endedAt               DateTime?     @map("ended_at") @db.Timestamp(6)
  satisfactionScore     Int?          @map("satisfaction_score")
  lowSatisfactionAlertSent Boolean    @default(false) @map("low_satisfaction_alert_sent")
  createdAt             DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  farmer                Farmer?       @relation(fields: [farmerId], references: [id])
  officer               User?         @relation(fields: [officerId], references: [id])
  messages              ChatMessage[]

  @@map("chat_conversations")
}

model ChatMessage {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId    String?          @map("conversation_id") @db.Uuid
  role              String           @db.VarChar(20)
  content           String
  language          String?          @db.VarChar(20)
  translatedContent String?          @map("translated_content")
  intent            String?          @db.VarChar(100)
  entities          Json?
  isVoice           Boolean?         @default(false) @map("is_voice")
  audioUrl          String?          @map("audio_url")
  createdAt         DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  conversation      ChatConversation? @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("chat_messages")
}

model Report {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        String    @db.VarChar(50)
  title       String    @db.VarChar(255)
  content     Json
  generatedBy String?   @map("generated_by") @db.Uuid
  status      String?   @default("draft") @db.VarChar(50)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  user        User?     @relation(fields: [generatedBy], references: [id])

  @@index([generatedBy])
  @@index([type])
  @@map("reports")
}

model AnalyticsEvent {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType String    @map("event_type") @db.VarChar(100)
  userId    String?   @map("user_id") @db.Uuid
  farmerId  String?   @map("farmer_id") @db.Uuid
  metadata  Json?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  user      User?     @relation(fields: [userId], references: [id])
  farmer    Farmer?   @relation(fields: [farmerId], references: [id])

  @@index([userId])
  @@index([farmerId])
  @@index([eventType])
  @@map("analytics_events")
}

model Alert {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            String    @db.VarChar(50)
  severity        String?   @default("medium") @db.VarChar(20)
  title           String    @db.VarChar(255)
  description     String?
  location        String?   @db.VarChar(255)
  affectedFarmers String[]  @map("affected_farmers") @db.Uuid
  isActive        Boolean?  @default(true) @map("is_active")
  notificationSent Boolean? @default(false) @map("notification_sent")
  alertNotificationSent Boolean? @default(false) @map("alert_notification_sent")
  triggeredAt     DateTime? @default(now()) @map("triggered_at") @db.Timestamp(6)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamp(6)
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([isActive])
  @@index([type])
  @@index([severity])
  @@map("alerts")
}

model SubscriptionPlan {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(100)
  description String?
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD") @db.VarChar(10)
  interval    String   @default("month") @db.VarChar(20)
  stripePriceId String? @map("stripe_price_id") @db.VarChar(255)
  features    Json?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamp(6)
  subscriptions Subscription[]
  vouchers      Voucher[]
  transactionSubmissions TransactionSubmission[]

  @@map("subscription_plans")
}

model Subscription {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  planId            String    @map("plan_id") @db.Uuid
  status            String    @default("active") @db.VarChar(50)
  currentPeriodStart DateTime  @map("current_period_start") @db.Timestamp(6)
  currentPeriodEnd   DateTime  @map("current_period_end") @db.Timestamp(6)
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  stripeSubscriptionId String?  @map("stripe_subscription_id") @db.VarChar(255)
  expiryNotificationSent Boolean @default(false) @map("expiry_notification_sent")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)
  user              User      @relation(fields: [userId], references: [id])
  plan              SubscriptionPlan @relation(fields: [planId], references: [id])
  payments          Payment[]
  usage             Usage?

  @@map("subscriptions")
}

model Payment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  amount         Decimal  @db.Decimal(10, 2)
  currency       String   @db.VarChar(10)
  status         String   @db.VarChar(50)
  paymentMethod  String?  @map("payment_method") @db.VarChar(50)
  transactionId  String?  @map("transaction_id") @db.VarChar(255)
  paidAt         DateTime? @map("paid_at") @db.Timestamp(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

model Usage {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId  String       @unique @map("subscription_id") @db.Uuid
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
  smsCount        Int          @default(0) @map("sms_count")
  aiChatCount     Int          @default(0) @map("ai_chat_count")
  reportCount     Int          @default(0) @map("report_count")
  lastResetAt     DateTime     @default(now()) @map("last_reset_at") @db.Timestamp(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime     @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("usage")
}

model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id])

  @@map("push_subscriptions")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(255)
  message   String
  isRead    Boolean   @default(false) @map("is_read")
  channel   String?   @default("in_app") @db.VarChar(50)
  metadata  Json?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  readAt    DateTime? @map("read_at") @db.Timestamp(6)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

model SystemConfig {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     String
  isSecret  Boolean  @default(false) @map("is_secret")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

model Share {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token       String    @unique @db.VarChar(255)
  entityType  String    @map("entity_type") @db.VarChar(50) // 'farmer', 'visit', 'report', 'knowledge'
  entityId    String    @map("entity_id") @db.Uuid
  createdBy   String?   @map("created_by") @db.Uuid
  isPublic    Boolean   @default(false) @map("is_public")
  expiresAt   DateTime? @map("expires_at") @db.Timestamp(6)
  permissions String[]  @default(["view"]) // permissions like 'view', 'edit'
  accessCount Int       @default(0) @map("access_count")
  lastAccessedAt DateTime? @map("last_accessed_at") @db.Timestamp(6)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  accesses    ShareAccess[]

  @@index([entityType, entityId])
  @@map("shares")
}

model ShareAccess {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shareId    String    @map("share_id") @db.Uuid
  accessedBy String?   @map("accessed_by") @db.VarChar(255) // IP or user id if logged in
  accessedAt DateTime? @default(now()) @map("accessed_at") @db.Timestamp(6)
  share      Share     @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@map("share_accesses")
}

model Voucher {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(50)
  planId      String   @map("plan_id") @db.Uuid
  isRedeemed  Boolean  @default(false) @map("is_redeemed")
  redeemedBy  String?  @map("redeemed_by") @db.Uuid
  redeemedAt  DateTime? @map("redeemed_at") @db.Timestamp(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamp(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
  redeemedByUser User? @relation("RedeemedVouchers", fields: [redeemedBy], references: [id])

  @@map("vouchers")
}

model TransactionSubmission {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  planId         String   @map("plan_id") @db.Uuid
  method         String   @db.VarChar(50)
  transactionId  String   @unique @map("transaction_id") @db.VarChar(100)
  amount         Decimal  @db.Decimal(10, 2)
  currency       String   @default("USD") @db.VarChar(10)
  status         String   @default("pending") @db.VarChar(20)
  rejectionReason String? @map("rejection_reason")
  verifiedAt     DateTime? @map("verified_at") @db.Timestamp(6)
  verifiedBy     String?  @map("verified_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user           User     @relation(fields: [userId], references: [id])
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("transaction_submissions")
}

model KnowledgeSearch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  query     String
  answer    String?
  reasoning String?
  visuals   Json?
  category  String?
  crop      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  user      User     @relation("UserKnowledgeSearches", fields: [userId], references: [id])

  @@map("knowledge_searches")
}

model SearchCache {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queryText       String   @map("query_text")
  normalizedQuery String   @unique @map("normalized_query")
  answer          String
  visuals         Json?    @map("visuals")
  contextUsed     Json     @map("context_used")
  embedding       Float[]
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("search_cache")
}

model ApiClient {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId        String   @map("owner_user_id") @db.Uuid
  name               String   @db.VarChar(120)
  status             String   @default("active") @db.VarChar(30)
  monthlyQuota       Int      @default(1000) @map("monthly_quota")
  currentPeriodStart DateTime @default(now()) @map("current_period_start") @db.Timestamp(6)
  currentPeriodEnd   DateTime @map("current_period_end") @db.Timestamp(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamp(6)
  owner              User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  keys               ApiKey[]
  usageEvents        ApiUsageEvent[]

  @@map("api_clients")
}

model ApiKey {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String    @map("client_id") @db.Uuid
  name         String    @db.VarChar(120)
  keyPrefix    String    @map("key_prefix") @db.VarChar(80)
  keyHash      String    @unique @map("key_hash") @db.VarChar(128)
  status       String    @default("active") @db.VarChar(30)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamp(6)
  expiresAt    DateTime? @map("expires_at") @db.Timestamp(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)
  client       ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  usageEvents  ApiUsageEvent[]

  @@map("api_keys")
}

model ApiUsageEvent {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String    @map("client_id") @db.Uuid
  apiKeyId  String?   @map("api_key_id") @db.Uuid
  endpoint  String    @db.VarChar(160)
  units     Int       @default(1)
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  client    ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  apiKey    ApiKey?   @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@map("api_usage_events")
}

model SmsHistory {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderId       String?   @map("sender_id") @db.Uuid
  recipientPhone String    @map("recipient_phone") @db.VarChar(20)
  farmerId       String?   @map("farmer_id") @db.Uuid
  message        String
  status         String?   @default("pending") @db.VarChar(50)
  provider       String?   @db.VarChar(50)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("sms_history")
}

model TropicalKnowledgeSource {
  id          String   @id @db.VarChar(100)
  name        String   @db.VarChar(255)
  provider    String   @db.VarChar(255)
  type        String   @db.VarChar(50)
  license     String?  @db.Text
  url         String   @db.Text
  syncMode    String   @map("sync_mode") @db.VarChar(50)
  topics      String[]
  crops       String[]
  regions     String[]
  description String?  @db.Text
  priority    String   @default("medium") @db.VarChar(20)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("tropical_knowledge_sources")
}

model Field {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmerId            String             @map("farmer_id") @db.Uuid
  name                String             @db.VarChar(100)
  areaHectares        Decimal?           @map("area_hectares") @db.Decimal(10, 2)
  soilType            String?            @map("soil_type") @db.VarChar(50)
  soilPh              Decimal?           @map("soil_ph") @db.Decimal(4, 2)
  boundaryCoordinates Json?              @map("boundary_coordinates")
  isActive            Boolean?           @default(true) @map("is_active")
  createdAt           DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime?          @default(now()) @map("updated_at") @db.Timestamp(6)
  farmer              Farmer             @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  cropCycles          CropCycle[]

  @@index([farmerId])
  @@map("fields")
}

model CropCycle {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fieldId             String             @map("field_id") @db.Uuid
  cropName            String             @map("crop_name") @db.VarChar(100)
  variety             String?            @db.VarChar(100)
  status              String             @default("planned") @db.VarChar(50) // 'planned', 'planted', 'growing', 'harvested'
  plantingDate        DateTime?          @map("planting_date") @db.Timestamp(6)
  expectedHarvestDate DateTime?          @map("expected_harvest_date") @db.Timestamp(6)
  actualHarvestDate   DateTime?          @map("actual_harvest_date") @db.Timestamp(6)
  yieldKg             Decimal?           @map("yield_kg") @db.Decimal(10, 2)
  notes               String?
  createdAt           DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime?          @default(now()) @map("updated_at") @db.Timestamp(6)
  field               Field              @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId])
  @@map("crop_cycles")
}

