generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String             @unique @db.VarChar(255)
  passwordHash  String             @map("password_hash") @db.VarChar(255)
  firstName     String             @map("first_name") @db.VarChar(100)
  lastName      String             @map("last_name") @db.VarChar(100)
  role          String             @default("extension_officer") @db.VarChar(50)
  region        String?            @db.VarChar(100)
  phone         String?            @db.VarChar(20)
  isDemo        Boolean            @default(false) @map("is_demo")
  managerId     String?            @map("manager_id") @db.Uuid
  manager       User?              @relation("ManagerOfficers", fields: [managerId], references: [id], onDelete: SetNull)
  managedOfficers User[]           @relation("ManagerOfficers")

  avatarUrl     String?            @map("avatar_url")
  isActive      Boolean?           @default(true) @map("is_active")
  resetToken    String?            @map("reset_token") @db.VarChar(255)
  resetTokenExpires DateTime?      @map("reset_token_expires") @db.Timestamp(6)
  createdAt     DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime?          @default(now()) @map("updated_at") @db.Timestamp(6)
  farmers       Farmer[]
  assignedFarmers Farmer[]          @relation("FarmerOfficer")
  visits        Visit[]
  conversations ChatConversation[]
  reports       Report[]
  analytics     AnalyticsEvent[]
  subscription  Subscription?
  pushSubscriptions PushSubscription[]
  notifications     Notification[]
  transactionSubmissions TransactionSubmission[]
  verifiedTransactions TransactionSubmission[] @relation("TransactionVerifier")
  redeemedVouchers Voucher[] @relation("RedeemedVouchers")
  createdShares Share[] @relation("ShareCreator")
  smsHistory SmsHistory[] @relation("SmsSender")
  hostedRooms WebRTCRoom[] @relation("RoomHost")
  scheduledSMS  ScheduledSMS[]
  knowledgeSearches KnowledgeSearch[] @relation("UserKnowledgeSearches")
  apiClients    ApiClient[]
  videoConsultations VideoConsultation[]
  offlineMutations OfflineMutation[]
  createdRecommendationReviews RecommendationReview[] @relation("ReviewCreator")
  completedRecommendationReviews RecommendationReview[] @relation("ReviewAssignee")
  recommendationOutcomes RecommendationOutcome[]
  assignmentRecords   FarmerAssignmentHistory[] @relation("AssignmentOfficer")
  reassignmentRecords FarmerAssignmentHistory[] @relation("AssignmentReassigner")
  uploads         UploadRecord[]
  recordedConsents DataConsent[] @relation("ConsentRecorder")
  dataExportRequests DataExportRequest[]
  createdSupportTickets SupportTicket[] @relation("SupportTicketCreator")
  assignedSupportTickets SupportTicket[] @relation("SupportTicketAssignee")
  lastLoginAt   DateTime?          @map("last_login_at") @db.Timestamp(6)
  loginHistories LoginHistory[]
  mfaEnabled    Boolean            @default(false) @map("mfa_enabled")
  mfaSecret     String?            @map("mfa_secret") @db.VarChar(255)
  mfaBackupCodes String[]          @default([]) @map("mfa_backup_codes")
  failedLoginAttempts Int          @default(0) @map("failed_login_attempts")
  lockoutUntil  DateTime?          @map("lockout_until") @db.Timestamp(6)
  sessions      UserSession[]
  tenantId       String?            @map("tenant_id") @db.Uuid
  tenant         Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tenantMemberships TenantMembership[]

  @@index([tenantId])
  @@map("users")
}

model OfflineMutation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  mutationKey    String   @map("mutation_key") @db.VarChar(128)
  operation      String   @db.VarChar(20)
  entityType     String   @map("entity_type") @db.VarChar(50)
  requestHash    String   @map("request_hash") @db.Char(64)
  status         String   @default("processing") @db.VarChar(20)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamp(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mutationKey])
  @@index([userId])
  @@index([status])
  @@map("offline_mutations")
}

model OutreachMessage {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmerId  String?   @map("farmer_id") @db.Uuid
  recipient String?   @db.VarChar(64)
  message   String
  channel   String    @default("sms") @db.VarChar(32)
  status    String    @default("queued") @db.VarChar(20)
  priority  String    @default("normal") @db.VarChar(20)
  attempts  Int       @default(0)
  lastError String?   @map("last_error")
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  farmer    Farmer?   @relation(fields: [farmerId], references: [id], onDelete: SetNull)

  @@index([farmerId])
  @@index([status, createdAt], map: "idx_outreach_messages_status")
  @@map("outreach_messages")
}

model ScheduledSMS {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  phoneNumber     String   @map("phone_number") @db.VarChar(20)
  message         String
  scheduledAt     DateTime @map("scheduled_at") @db.Timestamp(6)
  status          String   @default("pending") @db.VarChar(20) // 'pending', 'sent', 'failed'
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamp(6)
  user            User     @relation(fields: [userId], references: [id])

  @@map("scheduled_sms")
}

model Farmer {
   id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
   userId                   String?            @map("user_id") @db.Uuid
   assignedOfficerId        String?            @map("assigned_officer_id") @db.Uuid
   firstName                String             @map("first_name") @db.VarChar(100)
   lastName                 String             @map("last_name") @db.VarChar(100)
   phone                    String?            @db.VarChar(20)
   location                 String?            @db.VarChar(255)
   village                  String?            @db.VarChar(100)
   district                 String?            @db.VarChar(100)
   region                   String?            @db.VarChar(100)
   country                  String?            @default("Kenya") @db.VarChar(100)
   farmSizeHectares         Decimal?           @map("farm_size_hectares") @db.Decimal(10, 2)
   crops                    String[]
   vitalScore               Decimal?           @map("vital_score") @db.Decimal(5, 2)
   soilMoisture             Decimal?           @map("soil_moisture") @db.Decimal(5, 2)
   temperature              Decimal?           @db.Decimal(5, 2)
   phLevel                  Decimal?           @map("ph_level") @db.Decimal(4, 2)
   aiConfidence             Decimal?           @map("ai_confidence") @db.Decimal(5, 2)
   yieldHistory             Json?              @map("yield_history")
   locationLat              Decimal?           @map("location_lat") @db.Decimal(10, 8)
   locationLng              Decimal?           @map("location_lng") @db.Decimal(11, 8)
   languagePreference       String?            @default("en") @map("language_preference") @db.VarChar(20)
   isActive                 Boolean?           @default(true) @map("is_active")
   isDemo                   Boolean            @default(false) @map("is_demo")
   assignmentNotificationSent Boolean           @default(false) @map("assignment_notification_sent")
   order                    Int?               @default(0) @db.Integer
   createdAt                DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
   updatedAt                DateTime?          @default(now()) @map("updated_at") @db.Timestamp(6)
   user                     User?              @relation(fields: [userId], references: [id])
   assignedOfficer          User?              @relation("FarmerOfficer", fields: [assignedOfficerId], references: [id])
   tenantId                 String?            @map("tenant_id") @db.Uuid
   tenant                   Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
   visits                   Visit[]
   conversations            ChatConversation[]
   analytics                AnalyticsEvent[]
   fields                   Field[]
   videoConsultations       VideoConsultation[]
   consents                 DataConsent[]
   recommendationReviews   RecommendationReview[]
   recommendationOutcomes   RecommendationOutcome[]
   advisoryPreference       AdvisoryPreference?
   diagnosisEvents          DiagnosisEvent[]
   soilLabResults           SoilLabResult[]
   notifications            Notification[]
   farmerAssignmentHistory  FarmerAssignmentHistory[]
   outreachMessages         OutreachMessage[]
   smsHistory               SmsHistory[] @relation("SmsFarmer")
   exportRequests           DataExportRequest[]
   uploads                  UploadRecord[]
   whatsappMessages         WhatsappMessage[]
   smsFeedbacks             SmsFeedback[]

  @@index([assignedOfficerId])
  @@index([region])
  @@index([userId])
  @@index([tenantId])
  @@map("farmers")
}

model Visit {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String?   @map("tenant_id") @db.Uuid
  officerId            String?   @map("officer_id") @db.Uuid
  farmerId             String?   @map("farmer_id") @db.Uuid
  visitType            String?   @default("routine") @map("visit_type") @db.VarChar(50)
  status               String?   @default("scheduled") @db.VarChar(50)
  scheduledAt          DateTime? @map("scheduled_at") @db.Timestamp(6)
  startedAt            DateTime? @map("started_at") @db.Timestamp(6)
  completedAt          DateTime? @map("completed_at") @db.Timestamp(6)
  durationMinutes      Int?      @map("duration_minutes")
  locationLat          Decimal?  @map("location_lat") @db.Decimal(10, 8)
  locationLng          Decimal?  @map("location_lng") @db.Decimal(11, 8)
  notes                String?
  outcomes             String?
  followUpRequired     Boolean?  @default(false) @map("follow_up_required")
  followUpDate         DateTime? @map("follow_up_date") @db.Date
  reminderSent         Boolean?  @default(false) @map("reminder_sent")
  overdueAlertSent    Boolean?  @default(false) @map("overdue_alert_sent")
  followUpReminderSent Boolean?  @default(false) @map("follow_up_reminder_sent")
  createdAt            DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  tenant               Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  officer              User?     @relation(fields: [officerId], references: [id])
  farmer               Farmer?   @relation(fields: [farmerId], references: [id])
  attachments          VisitAttachment[]
  recommendationOutcomes RecommendationOutcome[]

  @@index([farmerId])
  @@index([officerId])
  @@index([status])
  @@index([tenantId])
  @@map("visits")
}

model KnowledgeArticle {
   id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
   title       String    @db.VarChar(255)
   content     String
   contentType String?   @default("text") @map("content_type") @db.VarChar(50)
   summary     String?
   category    String?   @db.VarChar(100)
   tags        String[]
   crops       String[]
   regions     String[]
   source      String?   @db.VarChar(255)
   sourceUrl   String?   @map("source_url")
   embedding   Float[]
   order       Int?      @default(0) @db.Integer
   createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
   updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
   chunks      KnowledgeChunk[]
   relationships KnowledgeRelationship[]

   @@index([category])
   @@index([tags], type: Gin)
   @@index([crops], type: Gin)
   @@map("knowledge_articles")
}

model ChatConversation {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String?       @map("tenant_id") @db.Uuid
  farmerId              String?       @map("farmer_id") @db.Uuid
  officerId             String?       @map("officer_id") @db.Uuid
  language              String?       @default("en") @db.VarChar(20)
  status                String?       @default("active") @db.VarChar(50)
  startedAt             DateTime?     @default(now()) @map("started_at") @db.Timestamp(6)
  endedAt               DateTime?     @map("ended_at") @db.Timestamp(6)
  satisfactionScore     Int?          @map("satisfaction_score")
  lowSatisfactionAlertSent Boolean    @default(false) @map("low_satisfaction_alert_sent")
  createdAt             DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  tenant                Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  farmer                Farmer?       @relation(fields: [farmerId], references: [id])
  officer               User?         @relation(fields: [officerId], references: [id])
  messages              ChatMessage[]

  @@index([tenantId])
  @@map("chat_conversations")
}

model ChatMessage {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId    String?          @map("conversation_id") @db.Uuid
  role              String           @db.VarChar(20)
  content           String
  language          String?          @db.VarChar(20)
  translatedContent String?          @map("translated_content")
  intent            String?          @db.VarChar(100)
  entities          Json?
  isVoice           Boolean?         @default(false) @map("is_voice")
  audioUrl          String?          @map("audio_url")
  createdAt         DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  conversation      ChatConversation? @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("chat_messages")
}

model Report {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  type        String    @db.VarChar(50)
  title       String    @db.VarChar(255)
  content     Json
  generatedBy String?   @map("generated_by") @db.Uuid
  status      String?   @default("draft") @db.VarChar(50)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  tenant      Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user        User?         @relation(fields: [generatedBy], references: [id])
  recommendationReviews RecommendationReview[]

  @@index([generatedBy])
  @@index([type])
  @@index([tenantId])
  @@map("reports")
}

model AnalyticsEvent {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType String    @map("event_type") @db.VarChar(100)
  userId    String?   @map("user_id") @db.Uuid
  farmerId  String?   @map("farmer_id") @db.Uuid
  metadata  Json?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  user      User?     @relation(fields: [userId], references: [id])
  farmer    Farmer?   @relation(fields: [farmerId], references: [id])

  @@index([userId])
  @@index([farmerId])
  @@index([eventType])
  @@map("analytics_events")
}

model Alert {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String?   @map("tenant_id") @db.Uuid
  type            String    @db.VarChar(50)
  severity        String?   @default("medium") @db.VarChar(20)
  title           String    @db.VarChar(255)
  description     String?
  location        String?   @db.VarChar(255)
  affectedFarmers String[]  @map("affected_farmers") @db.Uuid
  isActive        Boolean?  @default(true) @map("is_active")
  notificationSent Boolean? @default(false) @map("notification_sent")
  alertNotificationSent Boolean? @default(false) @map("alert_notification_sent")
  triggeredAt     DateTime? @default(now()) @map("triggered_at") @db.Timestamp(6)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamp(6)
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([type])
  @@index([severity])
  @@index([tenantId])
  @@map("alerts")
}

model SubscriptionPlan {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(100)
  description String?
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD") @db.VarChar(10)
  interval    String   @default("month") @db.VarChar(20)
  stripePriceId String? @map("stripe_price_id") @db.VarChar(255)
  features    Json?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamp(6)
  subscriptions Subscription[]
  vouchers      Voucher[]
  transactionSubmissions TransactionSubmission[]

  @@map("subscription_plans")
}

model Subscription {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  planId            String    @map("plan_id") @db.Uuid
  status            String    @default("active") @db.VarChar(50)
  currentPeriodStart DateTime  @map("current_period_start") @db.Timestamp(6)
  currentPeriodEnd   DateTime  @map("current_period_end") @db.Timestamp(6)
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  stripeSubscriptionId String?  @map("stripe_subscription_id") @db.VarChar(255)
  expiryNotificationSent Boolean @default(false) @map("expiry_notification_sent")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)
  user              User      @relation(fields: [userId], references: [id])
  plan              SubscriptionPlan @relation(fields: [planId], references: [id])
  payments          Payment[]
  usage             Usage?

  @@map("subscriptions")
}

model Payment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  amount         Decimal  @db.Decimal(10, 2)
  currency       String   @db.VarChar(10)
  status         String   @db.VarChar(50)
  paymentMethod  String?  @map("payment_method") @db.VarChar(50)
  transactionId  String?  @map("transaction_id") @db.VarChar(255)
  paidAt         DateTime? @map("paid_at") @db.Timestamp(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

model Usage {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId  String       @unique @map("subscription_id") @db.Uuid
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
  smsCount        Int          @default(0) @map("sms_count")
  aiChatCount     Int          @default(0) @map("ai_chat_count")
  reportCount     Int          @default(0) @map("report_count")
  lastResetAt     DateTime     @default(now()) @map("last_reset_at") @db.Timestamp(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime     @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("usage")
}

model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id])

  @@map("push_subscriptions")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  farmerId  String?   @map("farmer_id") @db.Uuid
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(255)
  message   String
  isRead    Boolean   @default(false) @map("is_read")
  channel   String?   @default("in_app") @db.VarChar(50)
  metadata  Json?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  readAt    DateTime? @map("read_at") @db.Timestamp(6)
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user      User      @relation(fields: [userId], references: [id])
  farmer    Farmer?   @relation(fields: [farmerId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([farmerId])
  @@index([tenantId])
  @@map("notifications")
}

model SystemConfig {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     String
  isSecret  Boolean  @default(false) @map("is_secret")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

model Share {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  token       String    @unique @db.VarChar(255)
  entityType  String    @map("entity_type") @db.VarChar(50) // 'farmer', 'visit', 'report', 'knowledge'
  entityId    String    @map("entity_id") @db.Uuid
  createdBy   String?   @map("created_by") @db.Uuid
  isPublic    Boolean   @default(false) @map("is_public")
  expiresAt   DateTime? @map("expires_at") @db.Timestamp(6)
  permissions String[]  @default(["view"]) // permissions like 'view', 'edit'
  accessCount Int       @default(0) @map("access_count")
  lastAccessedAt DateTime? @map("last_accessed_at") @db.Timestamp(6)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  accesses    ShareAccess[]
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  creator     User?     @relation("ShareCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdBy])
  @@index([tenantId])
  @@map("shares")
}

model ShareAccess {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shareId    String    @map("share_id") @db.Uuid
  accessedBy String?   @map("accessed_by") @db.VarChar(255) // IP or user id if logged in
  accessedAt DateTime? @default(now()) @map("accessed_at") @db.Timestamp(6)
  share      Share     @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@map("share_accesses")
}

model Voucher {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(50)
  planId      String   @map("plan_id") @db.Uuid
  isRedeemed  Boolean  @default(false) @map("is_redeemed")
  redeemedBy  String?  @map("redeemed_by") @db.Uuid
  redeemedAt  DateTime? @map("redeemed_at") @db.Timestamp(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamp(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
  redeemedByUser User? @relation("RedeemedVouchers", fields: [redeemedBy], references: [id])

  @@map("vouchers")
}

model TransactionSubmission {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  planId         String   @map("plan_id") @db.Uuid
  method         String   @db.VarChar(50)
  transactionId  String   @unique @map("transaction_id") @db.VarChar(100)
  amount         Decimal  @db.Decimal(10, 2)
  currency       String   @default("USD") @db.VarChar(10)
