{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": [
            "ES2020"
        ],
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "baseUrl": "./src",
        "types": [
            "node",
            "jest"
        ],
        "paths": {
            "@/*": [
                "./*"
            ],
            "@services/*": [
                "./services/*"
            ],
            "@routes/*": [
                "./routes/*"
            ],
            "@models/*": [
                "./models/*"
            ],
            "@middleware/*": [
                "./middleware/*"
            ],
            "@config/*": [
                "./config/*"
            ],
            "@utils/*": [
                "./utils/*"
            ]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}