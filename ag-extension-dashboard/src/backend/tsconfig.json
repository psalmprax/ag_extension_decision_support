{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": [
            "ES2020"
        ],
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "moduleResolution": "node",
        "typeRoots": [
            "./node_modules/@types"
        ],
        "types": ["node", "jest"],
        "allowSyntheticDefaultImports": true,
        "baseUrl": "./src",
        "paths": {
            "zod": [
                "../node_modules/zod"
            ],
            "@/*": [
                "./*"
            ],
            "@services/*": [
                "./services/*"
            ],
            "@routes/*": [
                "./routes/*"
            ],
            "@models/*": [
                "./models/*"
            ],
            "@middleware/*": [
                "./middleware/*"
            ],
            "@config/*": [
                "./config/*"
            ],
            "@utils/*": [
                "./utils/*"
            ],
            "@shared-api/*": [
                "./shared-api/*"
            ]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "src/__tests__/apiContract.test.ts"
    ]
}