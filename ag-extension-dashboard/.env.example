# =============================================================================
# Ag-Extension Decision Support Platform — Environment Variable Reference
# =============================================================================
# Copy this file to .env and fill in the values marked REQUIRED.
# Optional vars can be left empty or at their defaults shown below.
# =============================================================================

# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development            # development | staging | production
DATABASE_URL=                   # REQUIRED — PostgreSQL connection string
JWT_SECRET=                     # REQUIRED — 64+ char random string for JWT signing
CREDENTIAL_ENCRYPTION_KEY=      # REQUIRED — 32-byte hex key for encrypting stored credentials
API_BASE_URL=http://localhost:3000   # Public API base URL (used for webhook callbacks)
FRONTEND_URL=http://localhost:5173   # CORS origin for the frontend dev server
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
HOSTNAME=localhost
SERVER_IP=
PORT=3000

# ─── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Email ────────────────────────────────────────────────────────────────
EMAIL_SERVICE=smtp               # smtp | sendgrid | mailgun | ses
EMAIL_FROM=noreply@example.com
FROM_EMAIL=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAILGUN_USER=
MAILGUN_PASS=
SENDGRID_API_KEY=
AWS_SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── File Uploads ─────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ─── AI / LLM Providers ───────────────────────────────────────────────────
AI_PRIMARY_PROVIDER=openai       # openai | anthropic | groq | aihubmix | ollama | freebuff | azure | vertex
AI_PRIMARY_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
AIHUBMIX_API_KEY=
NVIDIA_API_KEY=
HUGGINGFACE_API_KEY=
OPENROUTER_API_KEY=
FREEBUFF_API_BASE_URL=
FREEBUFF_AUTH_TOKEN=
FREEBUFF_DEFAULT_MODEL=
OLLAMA_REQUEST_TIMEOUT_MS=30000
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
GOOGLE_VERTEX_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# ─── AI Agent Orchestration ───────────────────────────────────────────────
AGENT_ZERO_URL=http://localhost:5000
AGENT_ZERO_TOKEN=
CREW_AI_URL=http://localhost:5001
OPENCLAW_URL=http://localhost:5002

# ─── Communication Channels ───────────────────────────────────────────────
# SMS — Africa's Talking (primary) or Twilio
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp — Meta Cloud API (recommended) or Twilio
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=      # REQUIRED in production — random 32+ char secret
WHATSAPP_LOG_ONLY=false         # Set true to log WhatsApp webhooks without processing
TWILIO_WHATSAPP_NUMBER=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=AgExtensionBot

# ─── Remote Sensing & Ag Data ──────────────────────────────────────────────
NASA_EARTHDATA_KEY=              # Optional — NASA POWER works without a key
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# ─── Payments ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ─── Push Notifications ────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# ─── Domain / TLS ─────────────────────────────────────────────────────────
DOMAIN=api.gpexts.com
ACME_EMAIL=

# ─── Monitoring ────────────────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Search ────────────────────────────────────────────────────────────────
TAVILY_API_KEY=                  # Optional — web search fallback for AI agents

# ─── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_DISABLED=false

# ─── Voice / TTS ───────────────────────────────────────────────────────────
KNOWLEDGE_TTS_ENABLED=false

# ─── Feature Flags ─────────────────────────────────────────────────────────
# FREEBUFF_* vars control the fallback AI provider (see AI providers above)