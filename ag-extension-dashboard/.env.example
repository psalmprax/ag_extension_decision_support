# =============================================================================
# Ag-Extension Decision Support Platform — Environment Variable Reference
# =============================================================================
# Copy this file to .env and fill in the values marked REQUIRED.
# Optional vars can be left empty or at their defaults shown below.
# =============================================================================

# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development            # development | staging | production
DATABASE_URL=                   # REQUIRED — PostgreSQL connection string
JWT_SECRET=                     # REQUIRED — 64+ char random string for JWT signing
CREDENTIAL_ENCRYPTION_KEY=      # REQUIRED — 32-byte hex key for encrypting stored credentials
API_BASE_URL=http://localhost:3000   # Public API base URL (used for webhook callbacks)
FRONTEND_URL=http://localhost:5173   # CORS origin for the frontend dev server
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
HOSTNAME=localhost
SERVER_IP=
PORT=3000

# ─── System administrator (admin@agridemo.com) ──────────────────────────
# One-time initial password for the system administrator, read by the seed on
# deploy. At least 12 characters; never "password123" (published in this repo).
# Used only while the account still has that published default: once set, later
# deploys never reset it — change it in the app (Profile → Change password).
# Until this is set, admin@agridemo.com stays read-only and is not system admin.
# Production: set it as the repository secret SYSTEM_ADMIN_INITIAL_PASSWORD (Settings →
# Secrets and variables → Actions → Secrets; not a variable). The deploy passes it to
# the seed; a value here in the server .env also works. Remove either after first use.
SYSTEM_ADMIN_INITIAL_PASSWORD=

# ─── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Dedicated Redis for BullMQ queues — MUST run with --maxmemory-policy noeviction
# (an LRU queue Redis silently evicts pending jobs). Falls back to REDIS_URL.
# docker compose provides this as the redis-queue service.
# QUEUE_REDIS_URL=redis://:YOUR_REDIS_PASSWORD@localhost:7507

# ─── Email ────────────────────────────────────────────────────────────────
EMAIL_SERVICE=smtp               # smtp | sendgrid | mailgun | ses
EMAIL_FROM=noreply@example.com
FROM_EMAIL=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAILGUN_USER=
MAILGUN_PASS=
SENDGRID_API_KEY=
AWS_SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── File Uploads ─────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# Request body limits. Anonymous requests are capped at 1mb everywhere.
# Authenticated requests to media routes (speech, vision, uploads) get:
# LARGE_BODY_LIMIT=50mb
# Signature-verified webhooks (WhatsApp/Twilio inbound) are parsed BEFORE the
# signature check, so they get a smaller, separate cap:
# WEBHOOK_BODY_LIMIT=4mb

# ─── AI / LLM Providers ───────────────────────────────────────────────────
AI_PRIMARY_PROVIDER=aihubmix       # aihubmix | openai | anthropic | groq | ollama | freebuff | azure | vertex
AI_PRIMARY_MODEL=gemini-3.1-flash-lite
AIHUBMIX_WEB_SEARCH=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Default Claude model (claude-3-5-sonnet-* is retired; see Anthropic model deprecations)
ANTHROPIC_MODEL=claude-sonnet-5-5
GROQ_API_KEY=
AIHUBMIX_API_KEY=
AIHUBMIX_ACCESS_KEY=
NVIDIA_API_KEY=
HUGGINGFACE_API_KEY=
OPENROUTER_API_KEY=
FREEBUFF_API_BASE_URL=
FREEBUFF_AUTH_TOKEN=
FREEBUFF_DEFAULT_MODEL=
OLLAMA_REQUEST_TIMEOUT_MS=30000
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# Azure OpenAI data-plane API version used by the official OpenAI SDK's AzureOpenAI client
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment serving embeddings (separate from the chat deployment)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# Google Gemini: EITHER an API key (Gemini Developer API)...
GEMINI_API_KEY=
# ...OR a GCP project for Vertex AI (auth via GOOGLE_APPLICATION_CREDENTIALS).
GOOGLE_VERTEX_PROJECT_ID=
GOOGLE_VERTEX_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# ─── AI Agent Orchestration ───────────────────────────────────────────────
AGENT_ZERO_URL=http://localhost:5000
AGENT_ZERO_TOKEN=
CREW_AI_URL=http://localhost:5001
OPENCLAW_URL=http://localhost:5002

# ─── Communication Channels ───────────────────────────────────────────────
# SMS — Africa's Talking (primary) or Twilio
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
# Shared secret for Africa's Talking callbacks (it does not sign them). Add ?key=<secret> to the
# SMS, USSD and delivery-report callback URLs in the Africa's Talking dashboard.
AFRICASTALKING_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp — Meta Cloud API (recommended) or Twilio
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=      # REQUIRED in production — random 32+ char secret
META_APP_SECRET=                # REQUIRED in production — signs X-Hub-Signature-256 webhook payloads
WHATSAPP_LOG_ONLY=false         # Set true to log WhatsApp webhooks without processing
TWILIO_WHATSAPP_NUMBER=         # TWILIO_AUTH_TOKEN (above) validates X-Twilio-Signature on inbound payloads

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=AgExtensionBot
TELEGRAM_WEBHOOK_SECRET=        # Required; set the same secret_token when registering the Telegram webhook

# Public, reviewed knowledge hints only. Empty disables channel knowledge responses.
# See docs/USER_MANUAL.md for the JSON format and article revision hash.
MESSAGING_KB_PUBLIC_HINTS=

# ─── Remote Sensing & Ag Data ──────────────────────────────────────────────
NASA_EARTHDATA_KEY=              # Optional — NASA POWER works without a key
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# ─── Payments ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ─── Push Notifications ────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# ─── Domain / TLS ─────────────────────────────────────────────────────────
DOMAIN=api.gpexts.com
ACME_EMAIL=

# ─── Monitoring ────────────────────────────────────────────────────────────
SENTRY_DSN=
# Read token for GET /api/v1/monitoring/failures (the hourly error-watch workflow). Empty = endpoint off.
MONITORING_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Search ────────────────────────────────────────────────────────────────
TAVILY_API_KEY=                  # Optional — web search fallback for AI agents

# ─── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_DISABLED=false

# ─── Bot defence (unauthenticated routes) ──────────────────────────────────
# Per-IP buckets on the routes a bot can reach without an account. Defaults are
# sensible; raise only if real users on a shared network (NAT) hit the limit.
REGISTER_IP_MAX_PER_HOUR=10          # sign-ups per IP per hour
LOGIN_IP_MAX_PER_15MIN=30            # sign-in attempts per IP per 15 min (on top of per-account lockout)
SMS_REQUEST_IP_MAX_PER_HOUR=15       # SMS-code requests per IP per hour (SMS costs money)
PASSWORD_RESET_IP_MAX_PER_HOUR=10    # reset requests per IP per hour
# Sign-up honeypot + minimum fill time. The timing token is verified whenever the
# form sends one; set SIGNUP_BOT_CHECK_REQUIRED=true to REJECT sign-ups with no
# token (only after the frontend ships it, else self-signup breaks).
SIGNUP_MIN_FILL_MS=2500              # a form submitted faster than this is treated as a bot
SIGNUP_BOT_CHECK_REQUIRED=false
BOT_CHECK_SECRET=                    # Optional — HMAC key for the sign-up form token; falls back to JWT_SECRET

# ─── Voice / TTS ───────────────────────────────────────────────────────────
KNOWLEDGE_TTS_ENABLED=false

# ─── Advisory / Knowledge Workers ──────────────────────────────────────────
ADVISORY_ENGINE_ENABLED=false       # Daily weather texts to farmers; turn on once an agronomist has set district thresholds
FARMER_ALERTS_ENABLED=false         # Text farmers forecast severe weather and alerts officers chose to send (each SMS is paid for)
FARMER_ALERTS_DAILY_CAP=2           # Most alerts one farmer gets in 24 hours
GREENNESS_FLAG_STD=1                # Crop-stress flag for officers: greenness this many standard deviations below the 1984-2020 normal
DEAFRICA_WMS_URL=                   # Optional; defaults to https://ows.digitalearth.africa/wms (free, no key)
INGESTION_ENABLED=false             # Weekly web-extract crawl via Agent Zero + discovery-scraper (needs agents stack)
MCP_API_TOKEN=                      # Shared secret for agent containers calling /api/v1/mcp/* (generate: openssl rand -hex 32)
# ─── M-Pesa Daraja (STK push) — leave blank to keep manual receipt submission only ──
MPESA_ENV=sandbox                   # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=                    # Paybill / Till (e.g. 174379 in sandbox)
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=              # openssl rand -hex 24 — unguessable callback path segment
MPESA_KES_PER_USD=                  # required only if plans are priced in USD
PUBLIC_API_URL=                     # https://api.example.com — Safaricom must reach this

# ─── Uploads ────────────────────────────────────────────────────────────────
UPLOAD_QUOTA_MB=500                 # per-user total upload storage
CLAMD_HOST=                         # e.g. clamav (docker) — enables virus scanning of uploads
CLAMD_PORT=3310
CLAMD_FAIL_OPEN=false               # true = accept uploads when clamd is down (not recommended)

FAOSTAT_ALLOW_UNVERIFIED_FALLBACK=false # optional historical demo data; development/test only, never grounding evidence
REQUIRE_EMAIL_VERIFICATION=false     # true = block sign-in until the emailed link is clicked
TRUST_PROXY_HOPS=1                  # Number of reverse proxies in front of the API (Traefik = 1)
EMBEDDING_DIMENSIONS=768            # Width of stored embeddings; the HNSW indexes cover 768, other widths search unindexed

# ─── Knowledge retrieval (RAG) ─────────────────────────────────────────────
RAG_MIN_VECTOR_SIMILARITY=0.35      # Cosine similarity a passage needs to count as evidence (tune with scripts/rag-eval)
RAG_MIN_RERANK_SCORE=0.4            # Reranker score (0-1) a passage needs to count as evidence
RAG_TRANSLATE_QUERIES=true          # Translate non-English questions to English for keyword search
RAG_RERANK_URL=                     # Optional cross-encoder, Jina/Cohere /rerank format (e.g. https://api.jina.ai/v1/rerank); empty = LLM reranker
RAG_RERANK_MODEL=jina-reranker-v2-base-multilingual
RAG_RERANK_API_KEY=

# ─── Feature Flags ─────────────────────────────────────────────────────────
# FREEBUFF_* vars control the fallback AI provider (see AI providers above)
