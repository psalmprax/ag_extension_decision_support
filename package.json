{
  "name": "ag-extension-decision-support",
  "private": true,
  "description": "Ag Extension Decision Support System",
  "workspaces": [
    "ag-extension-shared",
    "ag-extension-browser-ext",
    "ag-extension-dashboard/src/*"
  ],
  "scripts": {
    "build:backend": "cd ag-extension-dashboard/src/backend && npm run build",
    "build:frontend": "cd ag-extension-dashboard/src/frontend && npm run build:docker",
    "build": "npm run build:backend && npm run build:frontend",
    "typecheck:frontend": "cd ag-extension-dashboard/src/frontend && npm run typecheck",
    "typecheck:backend": "cd ag-extension-dashboard/src/backend && npm run typecheck",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:backend",
    "test:backend": "cd ag-extension-dashboard/src/backend && npm test",
    "test:frontend": "cd ag-extension-dashboard/src/frontend && npm run test",
    "test": "npm run test:backend && npm run test:frontend",
    "test:e2e": "npx playwright test",
    "prepare": "husky || true",
    "lint:frontend": "cd ag-extension-dashboard/src/frontend && npm run lint",
    "lint:backend": "cd ag-extension-dashboard/src/backend && npm run lint",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "security:audit": "bash scripts/security-audit.sh",
    "security:test:backend": "cd ag-extension-dashboard/src/backend && npm test -- security",
    "security:test:frontend": "cd ag-extension-dashboard/src/frontend && npm run test -- src/__tests__/securityPolicy.test.ts src/__tests__/virtualizationAndThermal.test.ts src/__tests__/remoteWipeAndEncryptedStorage.test.ts src/__tests__/chaosNetworkSimulation.test.ts",
    "security:test:agents": "cd ag-extension-dashboard/src/agents && PATH=\"$HOME/.local/bin:$PATH\" PYTHONPATH=. pytest tests/test_security.py",
    "security:test:extension": "cd ag-extension-browser-ext && npm run test:security",
    "security:test": "npm run security:test:backend && npm run security:test:frontend && npm run security:test:agents && npm run security:test:extension",
    "fallow:check": "node scripts/fallow-regression-check.cjs",
    "fallow:baseline": "fallow dead-code --save-regression-baseline .fallow/regression-baseline.json",
    "fallow:audit": "fallow audit --base HEAD",
    "verify:anti-flop": "python3 scripts/verify_anti_flop.py",
    "verify:anti-hallucination": "python3 scripts/verify_anti_hallucination.py",
    "verify:anti": "npm run verify:anti-flop && npm run verify:anti-hallucination",
    "assurance:check": "node ag-extension-dashboard/scripts/assurance-gates.cjs"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/otlp-transformer": "^0.222.0",
    "@opentelemetry/propagator-jaeger": "^2.11.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/config": "6.19.3",
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.20.0",
    "protobufjs": "^8.6.6",
    "fallow": {
      "typescript": "~5.3.3"
    },
    "fallow-type-aware": {
      "typescript": "~5.3.3"
    }
  },
  "dependencies": {
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "@opengsd/gsd-pi": "^1.2.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/client": "6.19.3",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "fallow": "3.17.0",
    "prisma": "6.19.3",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  }
}
