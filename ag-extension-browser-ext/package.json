{
  "name": "ag-extension-browser-ext",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "typecheck": "wxt prepare && tsc --noEmit",
    "build:firefox": "wxt build -b firefox",
    "test": "vitest run",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "test:security": "node scripts/verify-security.js",
    "postinstall": "node scripts/fix-shared-link.cjs && wxt prepare"
  },
  "dependencies": {
    "@ag-extension/shared": "file:../ag-extension-shared",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^5.2.0",
    "@wxt-dev/module-react": "^1.1.3",
    "wxt": "^0.21.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "shell-quote": ">=1.8.5",
    "adm-zip": ">=0.6.0",
    "tmp": ">=0.2.6",
    "uuid": ">=11.1.1"
  }
}
